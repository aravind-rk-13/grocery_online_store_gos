# Copy to .env and fill in. .env is gitignored - never commit it. Claude is blocked from reading it (.claude/settings.json).
# Target application (admin console root; login page is APP_URL + /login)
APP_URL=https://groceryapp.uniqassosiates.com/admin
APP_USERNAME=
APP_PASSWORD=

# Jira Cloud + Confluence (same Atlassian site). Use a QA bot account's API token.
JIRA_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=GOS
CONFLUENCE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=GOS

# Xray Cloud (test steps, test sets, plans, executions, result import)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# CI only - set these as GitHub Actions secrets, never in this file:
#   ANTHROPIC_API_KEY  (Claude Code headless in .github/workflows/ai-pipeline.yml)
#   SLACK_WEBHOOK_URL  (optional failure alert in e2e.yml)