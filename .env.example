# Copy to .env and fill in. .env is gitignored - never commit it. Claude is blocked from reading it (.claude/settings.json).
# Manual mode needs only the values below. Jira and Confluence go through the Atlassian MCP (no token needed).

# Target application (admin console root; login page is APP_URL + /login)
APP_URL=https://groceryapp.uniqassosiates.com/admin
# Needed only when you run pytest. While exploring, you log in yourself in the Playwright MCP browser.
APP_USERNAME=
APP_PASSWORD=

# Xray Cloud API key (Xray > Settings > API Keys): test steps, test sets, plans, executions, result import.
# There is no Xray MCP, so scripts/xray_sync.py needs these.
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# Optional - only for the fallbacks scripts/atlassian_rest.py and `xray_sync.py link` (used when the Atlassian MCP
# is unavailable, or by the dormant headless pipeline). Leave empty in manual mode.
# JIRA_URL=https://aravindrk13.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# CONFLUENCE_URL=https://aravindrk13.atlassian.net/wiki
# JIRA_PROJECT_KEY=GOS           (default comes from config/workflow.json)

# Only if the dormant headless pipeline is switched on - set as GitHub Actions secrets, never in this file:
#   ANTHROPIC_API_KEY  (Claude Code headless in .github/workflows/ai-pipeline.yml)
